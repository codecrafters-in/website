# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# ── Gmail SMTP (server-side only — never expose these in frontend code) ──
# 1. Use your Gmail address as GMAIL_USER
# 2. GMAIL_APP_PASSWORD: Google Account → Security → 2-Step Verification
#    → App passwords → generate one for "Mail" → paste the 16-char code
# 3. Set these in Vercel dashboard: Settings → Environment Variables
#    These are NOT VITE_ prefixed — they stay server-side only
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
CONTACT_EMAIL=hello@codecrafters.in

# ── Booking (cal.com) — shown on Contact page + floating button when set ──
VITE_CAL_URL=https://cal.com/yourname/45min

# ── WhatsApp — PRIMARY conversion channel. Set this or the floating
#    button, the contact-page card and the footer chip all render nothing.
#    International format, no spaces. e.g. +919876543210
VITE_WHATSAPP_NUMBER=+91XXXXXXXXXX

# ── Analytics: Google Tag Manager container (GA4 configured inside GTM) ──
#    Unset = no analytics loads at all and the cookie banner stays hidden,
#    which keeps the privacy policy accurate. Format: GTM-XXXXXXX
VITE_GTM_ID=
