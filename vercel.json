      "permanent": true
    },
    {
      "source": "/odoo",
      "destination": "/solutions/odoo",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/products/quotemaker",
      "destination": "/work/quotemaker",
      "permanent": true
    },
    {
      "source": "/brand-design",
      "destination": "/solutions/brand-design",
      "permanent": true
    },
    {
      "source": "/about-us",
