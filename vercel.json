    {
      "source": "/services/web-development",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/services/mobile-app-development",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/services/on-demand",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/blog/page/2",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/blog/business-with-erp-solutions-2/patient-engagement-automation-odoo-ai",
      "destination": "/solutions/ai",
      "permanent": true
    },
    {
      "source": "/blog/business-with-erp-solutions-2/transform-odoo-with-voice-to-text-16",
      "destination": "/solutions/ai",
      "permanent": true
    },
    {
      "source": "/blog/business-with-erp-solutions-2/leveraging-odoo-s-api-for-intelligent",
      "destination": "/solutions/ai",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://*.googletagmanager.com https://cloudflareinsights.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
