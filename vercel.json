    },
    {
      "source": "/contactus",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/our-services",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/industries",
      "destination": "/solutions",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/ai-solutions",
      "destination": "/solutions/ai",
      "permanent": true
    },
    {
      "source": "/ai-agents-real-estate-usa",
      "destination": "/solutions/ai",
      "permanent": true
    },
    {
      "source": "/services/cloud-devops",
      "destination": "/solutions/cloud-devops",
      "permanent": true
    },
    {
      "source": "/services/ui-ux-design",
      "destination": "/solutions/brand-design",
      "permanent": true
    },
    {
      "source": "/services/saas",
      "destination": "/solutions",
